{
  "name": "astro-pages-cms-starter",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "npm run taxonomy:sync && astro check && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "sync:drive": "node scripts/sync-google-drive.mjs",
    "content:check": "npm run taxonomy:sync && node scripts/validate-content.mjs",
    "taxonomy:sync": "node scripts/enrich-taxonomy.mjs",
    "link:check": "node scripts/check-built-links.mjs",
    "agents:check": "node scripts/validate-agents.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.1.6",
    "googleapis": "^174.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "@rolldown/binding-wasm32-wasi": "^1.2.2",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}
