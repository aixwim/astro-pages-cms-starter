{
  "name": "astro-pages-cms-starter",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "npm run taxonomy:sync && NODE_OPTIONS=--max-old-space-size=2048 astro check && NODE_OPTIONS=--max-old-space-size=2048 astro build",
    "preview": "astro preview",
    "check": "NODE_OPTIONS=--max-old-space-size=2048 astro check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "sync:drive": "node scripts/sync-google-drive.mjs",
    "content:check": "npm run taxonomy:sync && node scripts/validate-content.mjs",
    "taxonomy:sync": "node scripts/enrich-taxonomy.mjs",
    "link:check": "node scripts/check-built-links.mjs",
    "agents:check": "node scripts/validate-agents.mjs",
    "postinstall": "node scripts/patch-wasi-preopen.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.1.6",
    "googleapis": "^174.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "@astrojs/compiler-binding-wasm32-wasi": "^0.3.2",
    "@bruits/satteri-wasm32-wasi": "0.9.5",
    "@rolldown/binding-wasm32-wasi": "^1.2.2",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "@emnapi/core": "1.11.3",
    "@emnapi/runtime": "1.11.3"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}