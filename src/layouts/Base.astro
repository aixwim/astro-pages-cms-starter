---
import site from '../data/site.json';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  publishedAt?: Date;
  updatedAt?: Date;
  image?: string;
  noindex?: boolean;
}

const {
  title = site.name,
  description = site.description,
  type = 'website',
  publishedAt,
  updatedAt,
  image = site.socialImage,
  noindex = false,
} = Astro.props;
const pageTitle = title === site.name ? title : `${title} - ${site.name}`;
const base = import.meta.env.BASE_URL;
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(`${base}${image}`, Astro.site);
const path = Astro.url.pathname;
const isActive = (segment: string) =>
  segment === ''
    ? path === base || path === base.slice(0, -1)
    : path.startsWith(`${base}${segment}`);
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.name,
  url: new URL(base, Astro.site).toString(),
  logo: new URL(base + 'logo.svg', Astro.site).toString(),
};
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem('aixwim-theme');
          const dark =
            saved === 'dark' ||
            (!saved && matchMedia('(prefers-color-scheme: dark)').matches);
          document.documentElement.dataset.theme = dark ? 'dark' : 'light';
        } catch {}
      })();
    </script>
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={noindex
        ? 'noindex,follow'
        : 'index,follow,max-image-preview:large'}
    />
    <meta name="theme-color" content="#07111f" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={base + 'favicon.svg'} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${site.name} RSS`}
      href={`${base}rss.xml`}
    />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`Identitas visual ${site.name}`} />
    {
      publishedAt && (
        <meta
          property="article:published_time"
          content={publishedAt.toISOString()}
        />
      )
    }
    {
      updatedAt && (
        <meta
          property="article:modified_time"
          content={updatedAt.toISOString()}
        />
      )
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(organizationSchema)}
    />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Lewati ke konten utama</a>
    <div class="reading-progress" aria-hidden="true"></div>
    <header class="shell nav">
      <a class="brand" href={base} aria-label={`${site.name}, beranda`}>
        <img
          class="brand-mark"
          src={base + 'favicon.svg'}
          alt=""
          width="32"
          height="32"
        />{site.name}
      </a>
      <button
        class="menu-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="primary-navigation"
      >
        <span class="menu-toggle__icon" aria-hidden="true"></span>
        <span class="sr-only">Buka menu</span>
      </button>
      <nav id="primary-navigation" aria-label="Navigasi utama">
        <a href={base} aria-current={isActive('') ? 'page' : undefined}
          >Beranda</a
        >
        <a
          href={`${base}insights/`}
          aria-current={isActive('insights/') ? 'page' : undefined}>Artikel</a
        >
        <a
          href={`${base}topik/`}
          aria-current={isActive('topik/') ? 'page' : undefined}>Topik</a
        >
        <a
          href={`${base}tentang/`}
          aria-current={isActive('tentang/') ? 'page' : undefined}>Tentang</a
        >
        <label class="language-switch">
          <span class="sr-only">Pilih bahasa</span>
          <select
            id="language-select"
            aria-label="Pilih bahasa"
            title="Pilih bahasa"
          >
            <option value="id" selected>ID</option>
            <option value="en">EN</option>
          </select>
        </label>
        <a
          class="nav-search"
          href={base + 'insights/#article-search'}
          aria-label="Cari artikel"
          title="Cari artikel"
        >
          <span aria-hidden="true"></span>
        </a>
        <button
          class="theme-toggle"
          type="button"
          aria-label="Aktifkan tema gelap"
          aria-pressed="false"
        >
          <span class="theme-icon" aria-hidden="true"></span>
        </button>
      </nav>
    </header>
    <main id="main-content"><slot /></main>
    <footer class="shell footer">
      <div class="footer-brand">
        <a class="brand" href={base}
          ><img
            class="brand-mark"
            src={base + 'favicon.svg'}
            alt=""
            width="32"
            height="32"
          />{site.name}</a
        >
        <p>{site.tagline}</p>
      </div>
      <div class="footer-nav">
        <div>
          <strong>Publikasi</strong>
          <a href={`${base}insights/`}>Artikel</a>
          <a href={`${base}topik/`}>Topik</a>
          <a href={`${base}rss.xml`}>RSS</a>
          <a href={`${base}tentang/`}>Tentang</a>
          <a href={`${base}kontak/`}>Kontak</a>
        </div>
        <div>
          <strong>Standar</strong>
          <a href={`${base}kebijakan-editorial/`}>Editorial</a>
          <a href={`${base}koreksi/`}>Koreksi</a>
          <a href={`${base}disclaimer/`}>Disclaimer</a>
        </div>
        <div>
          <strong>Legal</strong>
          <a href={`${base}privasi/`}>Privasi</a>
          <a href={`${base}ketentuan/`}>Ketentuan</a>
        </div>
      </div>
      <p class="footer-copy">&copy; {new Date().getFullYear()} {site.name}</p>
    </footer>
    <div class="ui-status sr-only" aria-live="polite"></div>
    <button
      class="back-to-top"
      type="button"
      aria-label="Kembali ke atas"
      title="Kembali ke atas"
    >
      <span aria-hidden="true"></span>
    </button>
    <script>
      const root = document.documentElement;
      const themeButton =
        document.querySelector<HTMLButtonElement>('.theme-toggle');
      const syncThemeButton = () => {
        const dark = root.dataset.theme === 'dark';
        themeButton?.setAttribute('aria-pressed', String(dark));
        themeButton?.setAttribute(
          'aria-label',
          dark ? 'Aktifkan tema terang' : 'Aktifkan tema gelap',
        );
      };
      syncThemeButton();
      themeButton?.addEventListener('click', () => {
        const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        localStorage.setItem('aixwim-theme', next);
        syncThemeButton();
      });

      const menuButton =
        document.querySelector<HTMLButtonElement>('.menu-toggle');
      const navigation = document.querySelector<HTMLElement>(
        '#primary-navigation',
      );
      const menuLabel = menuButton?.querySelector<HTMLElement>('.sr-only');
      const setMenu = (open: boolean) => {
        menuButton?.setAttribute('aria-expanded', String(open));
        navigation?.classList.toggle('is-open', open);
        document.body.classList.toggle('menu-open', open);
        if (menuLabel)
          menuLabel.textContent = open ? 'Tutup menu' : 'Buka menu';
      };
      menuButton?.addEventListener('click', () =>
        setMenu(menuButton.getAttribute('aria-expanded') !== 'true'),
      );
      navigation
        ?.querySelectorAll('a')
        .forEach((link) =>
          link.addEventListener('click', () => setMenu(false)),
        );
      addEventListener('keydown', (event) => {
        if (
          event.key === 'Escape' &&
          menuButton?.getAttribute('aria-expanded') === 'true'
        ) {
          setMenu(false);
          menuButton.focus();
        }
      });
      addEventListener('resize', () => {
        if (innerWidth > 750) setMenu(false);
      });

      const languageSelect =
        document.querySelector<HTMLSelectElement>('#language-select');
      languageSelect?.addEventListener('change', () => {
        if (languageSelect.value !== 'en') return;
        const translated = new URL('https://translate.google.com/translate');
        translated.searchParams.set('sl', 'id');
        translated.searchParams.set('tl', 'en');
        translated.searchParams.set('u', location.href);
        location.assign(translated);
      });

      const backToTop =
        document.querySelector<HTMLButtonElement>('.back-to-top');
      const syncBackToTop = () => {
        backToTop?.classList.toggle('is-visible', scrollY > 500);
      };
      backToTop?.addEventListener('click', () => {
        const reduceMotion = matchMedia(
          '(prefers-reduced-motion: reduce)',
        ).matches;
        scrollTo({ top: 0, behavior: reduceMotion ? 'auto' : 'smooth' });
      });
      addEventListener('scroll', syncBackToTop, { passive: true });
      syncBackToTop();

      const progress = document.querySelector<HTMLElement>('.reading-progress');
      addEventListener(
        'scroll',
        () => {
          const maximum = document.documentElement.scrollHeight - innerHeight;
          if (progress)
            progress.style.transform = `scaleX(${maximum > 0 ? scrollY / maximum : 0})`;
        },
        { passive: true },
      );
    </script>
  </body>
</html>
