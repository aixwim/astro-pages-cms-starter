---
import site from '../data/site.json';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}
const { title = site.name, description = site.description } = Astro.props;
const pageTitle = title === site.name ? title : `${title} · ${site.name}`;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b1020" />
    <link rel="icon" href={`${base}favicon.svg`} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <header class="shell nav">
      <a class="brand" href={base} aria-label={`${site.name} home`}
        ><span>N</span>{site.name}</a
      >
      <nav aria-label="Primary navigation">
        <a href={`${base}#services`}>Services</a><a href={`${base}insights/`}
          >Insights</a
        ><a class="button small" href={`mailto:${site.email}`}
          >Start a project</a
        >
      </nav>
    </header>
    <main><slot /></main>
    <footer class="shell footer">
      <div>
        <a class="brand" href={base}><span>N</span>{site.name}</a><p>
          {site.tagline}
        </p>
      </div>
      <p>© {new Date().getFullYear()} {site.name}. Built with Astro.</p>
    </footer>
  </body>
</html>
