---
import site from '../data/site.json';
import '../styles/global.css';
interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  publishedAt?: Date;
}
const {
  title = site.name,
  description = site.description,
  type = 'website',
  publishedAt,
} = Astro.props;
const pageTitle = title === site.name ? title : `${title} · ${site.name}`;
const base = import.meta.env.BASE_URL;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" /><meta
      name="viewport"
      content="width=device-width"
    />
    <meta name="description" content={description} /><meta
      name="robots"
      content="index,follow,max-image-preview:large"
    />
    <meta name="theme-color" content="#0b1020" /><link
      rel="canonical"
      href={canonical}
    /><link rel="icon" href={`${base}favicon.svg`} />
    <meta property="og:type" content={type} /><meta
      property="og:site_name"
      content={site.name}
    /><meta property="og:locale" content="id_ID" />
    <meta property="og:title" content={pageTitle} /><meta
      property="og:description"
      content={description}
    /><meta property="og:url" content={canonical} />
    {
      publishedAt && (
        <meta
          property="article:published_time"
          content={publishedAt.toISOString()}
        />
      )
    }
    <meta name="twitter:card" content="summary" /><title>{pageTitle}</title>
  </head>
  <body>
    <div class="reading-progress" aria-hidden="true"></div>
    <header class="shell nav">
      <a class="brand" href={base} aria-label={`Beranda ${site.name}`}
        ><span>A</span>{site.name}</a
      >
      <nav aria-label="Navigasi utama">
        <a href={base}>Beranda</a><a href={`${base}insights/`}>Artikel</a><a
          href={`${base}tentang/`}>Tentang</a
        ><button class="theme-toggle" type="button" aria-label="Ganti tema"
          >◐</button
        >
      </nav>
    </header>
    <main><slot /></main>
    <footer class="shell footer">
      <div class="footer-brand">
        <a class="brand" href={base}><span>A</span>{site.name}</a>
        <p>{site.tagline}</p>
      </div>
      <div class="footer-nav">
        <div>
          <strong>Publikasi</strong>
          <a href={`${base}insights/`}>Artikel</a>
          <a href={`${base}tentang/`}>Tentang</a>
          <a href={`${base}kontak/`}>Kontak</a>
        </div>
        <div>
          <strong>Standar</strong>
          <a href={`${base}kebijakan-editorial/`}>Editorial</a>
          <a href={`${base}koreksi/`}>Koreksi</a>
          <a href={`${base}disclaimer/`}>Disclaimer</a>
        </div>
        <div>
          <strong>Legal</strong>
          <a href={`${base}privasi/`}>Privasi</a>
          <a href={`${base}ketentuan/`}>Ketentuan</a>
        </div>
      </div>
      <p class="footer-copy">© {new Date().getFullYear()} {site.name}</p>
    </footer>
    <script is:inline>
      const r = document.documentElement,
        s = localStorage.getItem('aixwim-theme');
      if (s) r.dataset.theme = s;
      document.querySelector('.theme-toggle')?.addEventListener('click', () => {
        const n = r.dataset.theme === 'dark' ? 'light' : 'dark';
        r.dataset.theme = n;
        localStorage.setItem('aixwim-theme', n);
      });
      const p = document.querySelector('.reading-progress');
      addEventListener(
        'scroll',
        () => {
          const m = document.documentElement.scrollHeight - innerHeight;
          if (p) p.style.transform = `scaleX(${m > 0 ? scrollY / m : 0})`;
        },
        { passive: true },
      );
    </script>
  </body>
</html>
