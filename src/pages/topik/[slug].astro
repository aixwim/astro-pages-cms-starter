---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { topics } from '../../data/topics';
export function getStaticPaths() {
  return topics.map((topic) => ({
    params: { slug: topic.slug },
    props: { topic },
  }));
}
const { topic } = Astro.props;
const base = import.meta.env.BASE_URL;
const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .filter((post) =>
    (topic.categories as readonly string[]).includes(post.data.category),
  )
  .sort((a, b) =>
    a.id === topic.featuredId
      ? -1
      : b.id === topic.featuredId
        ? 1
        : b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
  );
const canonical = new URL(base + 'topik/' + topic.slug + '/', Astro.site);
const description =
  topic.description +
  ' Temukan ' +
  posts.length +
  ' panduan terkurasi dari Aixwim.';
const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: topic.name,
  description,
  url: canonical.toString(),
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: posts.map((post, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: post.data.title,
      url: new URL(base + 'insights/' + post.id + '/', Astro.site).toString(),
    })),
  },
};
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Beranda',
      item: new URL(base, Astro.site).toString(),
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Topik',
      item: new URL(base + 'topik/', Astro.site).toString(),
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: topic.name,
      item: canonical.toString(),
    },
  ],
};
---

<Base title={topic.name} description={description}>
  <script
    type="application/ld+json"
    set:html={JSON.stringify(collectionSchema)}
  /><script
    type="application/ld+json"
    set:html={JSON.stringify(breadcrumbSchema)}
  />
  <header class="shell page-head topic-head">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href={base}>Beranda</a><span aria-hidden="true">/</span><a
        href={base + 'topik/'}>Topik</a
      ><span aria-hidden="true">/</span><span aria-current="page"
        >{topic.name}</span
      >
    </nav><span class="eyebrow">{topic.eyebrow}</span><h1>{topic.name}</h1><p
      class="lead"
    >
      {topic.description}
    </p>
  </header>
  <section class="shell topic-path" aria-labelledby="path-title">
    <div class="section-title">
      <div>
        <span class="eyebrow">Mulai dari sini</span><h2 id="path-title">
          Jalur bacaan terkurasi.
        </h2>
      </div><span>{posts.length} panduan</span>
    </div><ol>
      {
        posts.map((post, index) => (
          <li>
            <>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <article>
                <>
                  <span class="eyebrow">{post.data.category}</span>
                  <h2>
                    <a href={base + 'insights/' + post.id + '/'}>
                      {post.data.title}
                    </a>
                  </h2>
                  <p>{post.data.description}</p>
                </>
              </article>
            </>
          </li>
        ))
      }
    </ol>
  </section>
</Base>
