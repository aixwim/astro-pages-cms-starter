---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { topics } from '../../data/topics';
const posts = await getCollection('posts', ({ data }) => !data.draft);
const base = import.meta.env.BASE_URL;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Topik utama Aixwim',
  description:
    'Jelajahi panduan utama Aixwim untuk hidup, belajar, dan bekerja di dunia digital.',
  url: new URL(base + 'topik/', Astro.site).toString(),
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: topics.map((topic, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: topic.name,
      url: new URL(base + 'topik/' + topic.slug + '/', Astro.site).toString(),
    })),
  },
};
---

<Base
  title="Topik Utama"
  description="Jelajahi panduan utama Aixwim tentang AI dan teknologi, karier dan produktivitas, serta belajar dan keterampilan."
>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  <header class="shell page-head topic-head">
    <span class="eyebrow">Peta pengetahuan Aixwim</span><h1>
      Jelajahi <em>topik utama.</em>
    </h1><p class="lead">
      Tiga jalur terkurasi untuk memahami teknologi, bekerja lebih baik, dan
      membangun keterampilan yang bertahan lama.
    </p>
  </header>
  <section class="shell topic-grid" aria-label="Daftar topik">
    {
      topics.map((topic, index) => {
        const count = posts.filter((post) =>
          (topic.categories as readonly string[]).includes(post.data.category),
        ).length;
        return (
          <article class="topic-card">
            <>
              <span class="topic-index">
                {String(index + 1).padStart(2, '0')}
              </span>
              <div>
                <>
                  <span class="eyebrow">{topic.eyebrow}</span>
                  <h2>
                    <a href={base + 'topik/' + topic.slug + '/'}>
                      {topic.name}
                    </a>
                  </h2>
                  <p>{topic.description}</p>
                  <a
                    class="text-link"
                    href={base + 'topik/' + topic.slug + '/'}
                  >
                    Jelajahi {count} panduan
                  </a>
                </>
              </div>
            </>
          </article>
        );
      })
    }
  </section>
</Base>
