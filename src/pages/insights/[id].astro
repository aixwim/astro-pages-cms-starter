---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import site from '../../data/site.json';
import { getTopicByCategory } from '../../data/topics';

export async function getStaticPaths() {
  return (await getCollection('posts', ({ data }) => !data.draft)).map(
    (post) => ({ params: { id: post.id }, props: { post } }),
  );
}

const { post } = Astro.props;
const { Content } = await render(post);
const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const topic = getTopicByCategory(post.data.category);
const related = allPosts
  .filter(
    (candidate) =>
      candidate.id !== post.id &&
      (topic.categories as readonly string[]).includes(candidate.data.category),
  )
  .sort((a, b) => {
    const aScore = a.data.category === post.data.category ? 1 : 0;
    const bScore = b.data.category === post.data.category ? 1 : 0;
    return (
      bScore - aScore ||
      b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf()
    );
  })
  .slice(0, 3);
const minutes = Math.max(
  1,
  Math.ceil((post.body?.trim().split(/\s+/).filter(Boolean).length ?? 0) / 220),
);
const base = import.meta.env.BASE_URL;
const canonical = new URL(Astro.url.pathname, Astro.site);
const image = new URL(`${base}${post.data.image}`, Astro.site);
const shareTitle = encodeURIComponent(post.data.title);
const shareUrl = encodeURIComponent(canonical.toString());
const schema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.seoTitle ?? post.data.title,
  description: post.data.seoDescription ?? post.data.description,
  datePublished: post.data.publishedAt.toISOString(),
  dateModified: (post.data.updatedAt ?? post.data.publishedAt).toISOString(),
  inLanguage: 'id-ID',
  articleSection: topic.name,
  keywords: post.data.tags.join(', '),
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical.toString() },
  image: image.toString(),
  author: { '@type': 'Organization', name: post.data.author },
  publisher: {
    '@type': 'Organization',
    name: site.name,
    url: new URL(base, Astro.site).toString(),
    logo: {
      '@type': 'ImageObject',
      url: new URL(base + 'logo.svg', Astro.site).toString(),
    },
  },
};
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Beranda',
      item: new URL(base, Astro.site).toString(),
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Topik',
      item: new URL(`${base}topik/`, Astro.site).toString(),
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: topic.name,
      item: new URL(`${base}topik/${topic.slug}/`, Astro.site).toString(),
    },
    {
      '@type': 'ListItem',
      position: 4,
      name: post.data.title,
      item: canonical.toString(),
    },
  ],
};
---

<Base
  title={post.data.seoTitle ?? post.data.title}
  description={post.data.seoDescription ?? post.data.description}
  type="article"
  publishedAt={post.data.publishedAt}
  updatedAt={post.data.updatedAt}
  image={post.data.image}
  imageAlt={post.data.imageAlt}
  canonicalUrl={post.data.canonicalUrl}
  author={post.data.author}
  section={topic.name}
  noindex={post.data.noindex}
>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  <script
    type="application/ld+json"
    set:html={JSON.stringify(breadcrumbSchema)}
  />
  <article class="shell article">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href={base}>Beranda</a><span aria-hidden="true">/</span><a
        href={`${base}topik/`}>Topik</a
      ><span aria-hidden="true">/</span><a href={`${base}topik/${topic.slug}/`}
        >{topic.name}</a
      ><span aria-hidden="true">/</span><span aria-current="page">Tulisan</span>
    </nav>
    <header>
      <div class="article-kicker">
        <a href={`${base}topik/${topic.slug}/`}>{topic.name}</a><span
          >{minutes} menit baca</span
        >
      </div>
      <h1>{post.data.title}</h1>
      <p>{post.data.description}</p>
      <div class="byline">
        <span>Oleh <strong>{post.data.author}</strong></span>
        <time datetime={post.data.publishedAt.toISOString()}>
          {
            post.data.publishedAt.toLocaleDateString('id-ID', {
              day: 'numeric',
              month: 'long',
              year: 'numeric',
            })
          }
        </time>
      </div>
      {
        post.data.updatedAt && (
          <p class="updated-at">
            Diperbarui{' '}
            <time datetime={post.data.updatedAt.toISOString()}>
              {post.data.updatedAt.toLocaleDateString('id-ID', {
                day: 'numeric',
                month: 'long',
                year: 'numeric',
              })}
            </time>
          </p>
        )
      }
    </header>
    <figure class="article-hero">
      <img
        src={`${base}${post.data.image}`}
        alt={post.data.imageAlt}
        width="1200"
        height="630"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </figure>
    <div class="prose"><Content /></div>
    <section class="share-panel" aria-labelledby="share-title">
      <div>
        <span class="eyebrow">Bagikan wawasan</span>
        <h2 id="share-title">Bermanfaat untuk orang lain?</h2>
      </div>
      <div class="share-actions">
        <button
          class="share-native"
          type="button"
          aria-label="Bagikan"
          title="Bagikan"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="6" cy="12" r="2.5"></circle>
            <circle cx="18" cy="5" r="2.5"></circle>
            <circle cx="18" cy="19" r="2.5"></circle>
            <path d="m8.2 10.8 7.6-4.5M8.2 13.2l7.6 4.5"></path>
          </svg>
        </button>
        <a
          href={`https://wa.me/?text=${shareTitle}%20${shareUrl}`}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Bagikan melalui WhatsApp"
          title="WhatsApp"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M20 11.6a8 8 0 0 1-11.8 7L4 20l1.4-4.1A8 8 0 1 1 20 11.6Z"
            ></path>
            <path d="M9 8.5c.5 3 2 4.5 5 5l1-1.3"></path>
          </svg>
        </a>
        <a
          href={`https://www.linkedin.com/sharing/share-offsite/?url=${shareUrl}`}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Bagikan melalui LinkedIn"
          title="LinkedIn"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="6" cy="6" r="1.5"></circle>
            <path d="M4.5 10v9M10 19v-9m0 4c1-5 8-5 8 1v4"></path>
          </svg>
        </a>
        <a
          href={`https://twitter.com/intent/tweet?text=${shareTitle}&url=${shareUrl}`}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Bagikan melalui X"
          title="X"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M5 4 19 20M19 4 5 20"></path>
          </svg>
        </a>
        <a
          href={`mailto:?subject=${shareTitle}&body=${shareUrl}`}
          aria-label="Bagikan melalui email"
          title="Email"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <rect x="3.5" y="5.5" width="17" height="13" rx="2"></rect>
            <path d="m5 7 7 6 7-6"></path>
          </svg>
        </a>
      </div>
      <p class="share-feedback sr-only" aria-live="polite"></p>
    </section>

    <footer class="article-footer">
      <p>
        Artikel ini dapat diperbarui ketika tersedia informasi yang lebih baik.
      </p>
      <button class="copy-link" type="button">Salin tautan</button>
    </footer>
    <section class="comments" id="komentar" aria-labelledby="comments-title">
      <span class="eyebrow">Ruang pembaca</span>
      <h2 id="comments-title">Komentar dan diskusi</h2>
      <p>
        Komentar dikelola melalui GitHub Discussions. Masuk dengan akun GitHub
        dan ikuti pedoman percakapan yang saling menghormati.
      </p>
      <div class="comments-consent">
        <p>
          Konten dari Giscus baru dimuat setelah Anda memilih tombol berikut.
          GitHub dapat memproses data sesuai kebijakan privasinya.
        </p>
        <button class="button load-comments" type="button">Muat komentar</button
        >
        <a
          class="text-link"
          href="https://github.com/aixwim/astro-pages-cms-starter/discussions"
          target="_blank"
          rel="noopener noreferrer">Buka Discussions</a
        >
      </div>
      <div class="giscus-container"></div>
    </section>
    {
      related.length > 0 && (
        <aside class="related-posts" aria-labelledby="related-title">
          <span class="eyebrow">Bacaan berikutnya</span>
          <h2 id="related-title">Artikel terkait</h2>
          <div>
            {related.map((item) => (
              <a href={`${base}insights/${item.id}/`}>
                <span>{item.data.category}</span>
                <strong>{item.data.title}</strong>
              </a>
            ))}
          </div>
        </aside>
      )
    }
  </article>
  <script>
    const nativeShare =
      document.querySelector<HTMLButtonElement>('.share-native');
    const shareFeedback =
      document.querySelector<HTMLElement>('.share-feedback');
    if (!navigator.share) nativeShare?.setAttribute('hidden', '');
    nativeShare?.addEventListener('click', async () => {
      try {
        await navigator.share({ title: document.title, url: location.href });
        if (shareFeedback) shareFeedback.textContent = 'Panel berbagi dibuka.';
      } catch (error) {
        if (
          shareFeedback &&
          error instanceof DOMException &&
          error.name !== 'AbortError'
        )
          shareFeedback.textContent = 'Berbagi dibatalkan atau tidak tersedia.';
      }
    });

    const loadComments =
      document.querySelector<HTMLButtonElement>('.load-comments');
    const commentsConsent =
      document.querySelector<HTMLElement>('.comments-consent');
    const giscusContainer =
      document.querySelector<HTMLElement>('.giscus-container');
    const syncGiscusTheme = () => {
      const iframe = document.querySelector<HTMLIFrameElement>(
        'iframe.giscus-frame',
      );
      iframe?.contentWindow?.postMessage(
        {
          giscus: {
            setConfig: {
              theme:
                document.documentElement.dataset.theme === 'dark'
                  ? 'dark'
                  : 'light',
            },
          },
        },
        'https://giscus.app',
      );
    };
    loadComments?.addEventListener('click', () => {
      if (!giscusContainer || giscusContainer.dataset.loaded === 'true') return;
      giscusContainer.dataset.loaded = 'true';
      const giscus = document.createElement('script');
      const attributes = {
        src: 'https://giscus.app/client.js',
        'data-repo': 'aixwim/astro-pages-cms-starter',
        'data-repo-id': 'R_kgDOTszSrw',
        'data-category': 'General',
        'data-category-id': 'DIC_kwDOTszSr84DCmL_',
        'data-mapping': 'pathname',
        'data-strict': '1',
        'data-reactions-enabled': '1',
        'data-emit-metadata': '0',
        'data-input-position': 'top',
        'data-theme':
          document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light',
        'data-lang': 'id',
        'data-loading': 'lazy',
        crossorigin: 'anonymous',
        async: 'true',
      };
      Object.entries(attributes).forEach(([name, value]) =>
        giscus.setAttribute(name, value),
      );
      giscusContainer.append(giscus);
      commentsConsent?.setAttribute('hidden', '');
      new MutationObserver(syncGiscusTheme).observe(document.documentElement, {
        attributes: true,
        attributeFilter: ['data-theme'],
      });
    });

    const button = document.querySelector<HTMLButtonElement>('.copy-link');
    button?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(location.href);
        button.textContent = 'Tautan tersalin';
      } catch {
        button.textContent = 'Salin alamat dari browser';
      }
      setTimeout(() => (button.textContent = 'Salin tautan'), 1800);
    });
  </script>
</Base>
