---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
export async function getStaticPaths() {
  return (await getCollection('posts')).map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}
const { post } = Astro.props;
const { Content } = await render(post);
---

<Base title={post.data.title} description={post.data.description}>
  <article class="shell article">
    <a class="text-link" href={`${import.meta.env.BASE_URL}insights/`}
      >← All insights</a
    ><header>
      <time
        >{
          post.data.publishedAt.toLocaleDateString('en', {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
          })
        }</time
      ><h1>{post.data.title}</h1><p>{post.data.description}</p>
    </header><div class="prose"><Content /></div>
  </article>
</Base>
