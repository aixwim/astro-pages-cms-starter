---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import site from '../data/site.json';
const posts = (await getCollection('posts')).sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
);
const featured = posts.find((p) => p.data.featured) ?? posts[0];
const latest = posts.filter((p) => p.id !== featured?.id).slice(0, 6);
const mins = (body = '') =>
  Math.max(1, Math.ceil(body.trim().split(/\s+/).filter(Boolean).length / 220));
---

<Base>
  <section class="shell editorial-hero">
    <div>
      <span class="eyebrow">Teknologi · Kreativitas · Kehidupan modern</span><h1
      >
        Gagasan jernih untuk dunia yang <em>terus bergerak.</em>
      </h1>
    </div><p>{site.description}</p>
  </section>
  {
    featured && (
      <section class="shell featured-story">
        <>
          <div class="feature-mark">A</div>
          <article>
            <>
              <span class="eyebrow">Pilihan redaksi</span>
              <h2>
                <a href={`${import.meta.env.BASE_URL}insights/${featured.id}/`}>
                  {featured.data.title}
                </a>
              </h2>
              <p>{featured.data.description}</p>
              <div class="story-meta">
                <>
                  <time>
                    {featured.data.publishedAt.toLocaleDateString('id-ID', {
                      day: 'numeric',
                      month: 'long',
                      year: 'numeric',
                    })}
                  </time>
                  <span>{mins(featured.body)} menit baca</span>
                </>
              </div>
            </>
          </article>
        </>
      </section>
    )
  }
  <section class="shell section">
    <div class="section-title">
      <div>
        <span class="eyebrow">Terbaru</span><h2>
          Pengetahuan yang bisa digunakan.
        </h2>
      </div><a class="text-link" href={`${import.meta.env.BASE_URL}insights/`}
        >Semua artikel →</a
      >
    </div>
    <div class="editorial-grid">
      {
        latest.map((post, i) => (
          <article class="story-card">
            <>
              <span class="story-number">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <>
                  <h3>
                    <a href={`${import.meta.env.BASE_URL}insights/${post.id}/`}>
                      {post.data.title}
                    </a>
                  </h3>
                  <p>{post.data.description}</p>
                </>
              </div>
              <div class="story-meta">
                <>
                  <time>
                    {post.data.publishedAt.toLocaleDateString('id-ID', {
                      day: 'numeric',
                      month: 'short',
                      year: 'numeric',
                    })}
                  </time>
                  <span>{mins(post.body)} menit</span>
                </>
              </div>
            </>
          </article>
        ))
      }
    </div>
  </section>
  <section class="shell editorial-note">
    <span class="eyebrow">Prinsip redaksi</span><blockquote>
      “Kami menulis untuk membantu pembaca memahami sesuatu—bukan sekadar
      mengejar perhatian.”
    </blockquote><a
      class="button light"
      href={`${import.meta.env.BASE_URL}tentang/`}>Kenali Aixwim Insights →</a
    >
  </section>
</Base>
