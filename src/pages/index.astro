---
import Base from '../layouts/Base.astro';
import site from '../data/site.json';
---

<Base>
  <section class="shell hero">
    <div class="eyebrow">Independent digital studio · 2026</div>
    <h1>Make your next move <em>unmistakable.</em></h1>
    <p class="lead">{site.description}</p>
    <div class="actions">
      <a class="button" href={`mailto:${site.email}`}
        >Build with us <span>↗</span></a
      ><a class="text-link" href="#services">Explore capabilities ↓</a>
    </div>
    <div class="signal"><span></span> Available for select projects</div>
  </section>
  <section class="shell metrics" aria-label="Highlights">
    <article>
      <strong>95+</strong><span>Performance target</span>
    </article><article>
      <strong>0</strong><span>CMS database</span>
    </article><article>
      <strong>24/7</strong><span>Automated delivery</span>
    </article>
  </section>
  <section class="shell section" id="services">
    <div class="section-head">
      <div>
        <span class="eyebrow">Capabilities</span><h2>
          Clarity from strategy to ship.
        </h2>
      </div><p>
        One thoughtful system for content, design, development, and dependable
        delivery.
      </p>
    </div>
    <div class="cards">
      <article>
        <span>01</span><h3>Strategy & identity</h3><p>
          Positioning, language, and a visual system designed to stay useful as
          you grow.
        </p>
      </article>
      <article>
        <span>02</span><h3>Web experiences</h3><p>
          Fast, accessible Astro experiences with deliberate motion and strong
          editorial rhythm.
        </p>
      </article>
      <article>
        <span>03</span><h3>Content operations</h3><p>
          Pages CMS, GitHub, and Drive connected in a workflow your whole team
          can trust.
        </p>
      </article>
    </div>
  </section>
  <section class="shell cta">
    <span class="eyebrow">Have an ambitious idea?</span><h2>
      Let’s turn it into something people remember.
    </h2><a class="button light" href={`mailto:${site.email}`}
      >Tell us about it <span>↗</span></a
    >
  </section>
</Base>
